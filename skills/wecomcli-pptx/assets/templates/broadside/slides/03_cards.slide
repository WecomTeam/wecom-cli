<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', position: 'relative', padding: '40px 70px 0 70px', fontFamily: 'Microsoft YaHei' }}>
    <Box style={{ width: 1140, height: 112 }}>
        <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', height: 30, borderBottom: '1px solid #E5E7EB' }}>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                <Box style={{ height: 22, padding: '0 12px', borderRadius: 11, background: '#C42819', alignItems: 'center', justifyContent: 'center' }}>
                    <Text style={{ fontFamily: 'Arial', fontSize: 12, fontWeight: 'bold', color: '#FFFFFF', letterSpacing: 1, lineHeight: 1 }}>PART 01</Text>
                </Box>
                <Text style={{ fontSize: 14, letterSpacing: 2, color: '#6B7280' }}>基础工作</Text>
            </Box>
            <Text style={{ fontSize: 14, letterSpacing: 2, color: '#6B7280' }}>三项要点</Text>
        </Box>

        <Box style={{ marginTop: 22, flexDirection: 'row', alignItems: 'center', gap: 16, height: 60 }}>
            <Box style={{ width: 12, height: 44, background: '#C42819' }} />
            <Text style={{ fontSize: 42, fontWeight: 900, lineHeight: 1.2, color: '#1A1616', whiteSpace: 'nowrap' }}>基础工作靠三件事撑起来：走访、台账、回访</Text>
        </Box>
    </Box>

    <Box style={{ marginTop: 24, width: 1140, height: 452 }}>
        <Box style={{ flexDirection: 'row', gap: 24 }}>
            {[
                ['01', '走访', '按网格入户，全年不断线', '全年按网格开展入户走访，重点关注独居老人、困难家庭和新迁入居民三类群体。走访不设固定话术，先听居民说什么，再登记诉求类别；能当场答复的当场答复，需要协调的明确反馈时限，避免走访变成打卡，也避免居民反复说同一件事。', '全年入户走访覆盖全部网格'],
                ['02', '台账', '一户一页，逐月更新', '民情台账按户建档，记录家庭结构、特殊需求和历次诉求办理情况，每月由网格员集中更新一次。台账数据同时用于安排走访频次：情况稳定的季度走访，有特殊需求的每月走访，紧急情况随时跟进，不搞一刀切，也不让台账停在纸面。', '台账每月更新，季度核对'],
                ['03', '回访', '事项办结后再问一次', '每一件登记诉求在办结后一周内回访，确认居民是否认可处理结果。回访中发现处理不到位或居民有新情况的，重新派单跟进；年底对全部办结事项集中回头看，未办结和居民不满意的事项转入下一年度清单，逐项说明原因和下一步安排。', '办结事项一周内回访'],
            ].map((c, i) => (
                <Box key={i} style={{ width: 364, height: 452, borderRadius: 14, border: '1px solid #E5E7EB', background: '#FFFFFF', overflow: 'hidden' }}>
                    <Box style={{ height: 56, background: '#C42819', flexDirection: 'row', alignItems: 'center', gap: 14, padding: '0 24px' }}>
                        <Text style={{ fontFamily: 'Courier New', fontSize: 18, fontWeight: 700, letterSpacing: 2, color: '#FFE79B', lineHeight: 1 }}>{`/ ${c[0]}`}</Text>
                        <Text style={{ fontSize: 26, fontWeight: 900, color: '#FFFFFF', lineHeight: 1, letterSpacing: 4 }}>{c[1]}</Text>
                    </Box>
                    <Box style={{ height: 396, padding: '20px 24px 20px 24px', justifyContent: 'space-between' }}>
                        <Box style={{ gap: 12 }}>
                            <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#C42819', lineHeight: 1.3 }}>{c[2]}</Text>
                            <Text style={{ fontSize: 18, color: '#1A1616', lineHeight: 1.75 }}>{c[3]}</Text>
                        </Box>
                        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, paddingTop: 14, borderTop: '1px solid #E5E7EB' }}>
                            <Box style={{ width: 6, height: 24, background: '#E19825' }} />
                            <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#1A1616', lineHeight: 1.2 }}>{c[4]}</Text>
                        </Box>
                    </Box>
                </Box>
            ))}
        </Box>
    </Box>

    <Box style={{ position: 'absolute', left: 0, top: 660, width: 1280, height: 9, flexDirection: 'row' }}>
        <Box style={{ width: 678, height: 9, background: '#C42819' }} />
        <Box style={{ width: 333, height: 9, background: '#EE5530' }} />
        <Box style={{ width: 269, height: 9, background: '#F26B40' }} />
    </Box>
    <Text style={{ position: 'absolute', left: 70, top: 678, fontSize: 14, letterSpacing: 2, color: '#6B7280', lineHeight: 1 }}>年度党课宣讲</Text>
    <Text style={{ position: 'absolute', right: 70, top: 678, fontFamily: 'Courier New', fontSize: 14, color: '#6B7280', lineHeight: 1 }}>05 / 12</Text>
</Slide>
