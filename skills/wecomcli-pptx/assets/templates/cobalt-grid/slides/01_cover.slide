<Slide style={{ background: '#F0EBDE', padding: '19px 48px 14px 48px', position: 'relative' }}>
    <svg width={1280} height={719} viewBox='0 0 1280 719' style={{ position: 'absolute', top: 1, left: 0, zIndex: 0 }}>
        <defs>
            <pattern id='grid' width='32' height='32' patternUnits='userSpaceOnUse'>
                <path d='M 32 0 L 0 0 0 32' fill='none' stroke='#DBD8DE' strokeWidth='1' />
            </pattern>
            <pattern id='scan' width='10' height='40' patternUnits='userSpaceOnUse'>
                <line x1='2' y1='0' x2='2' y2='40' stroke='#1F2BE0' strokeWidth='3.5' />
            </pattern>
        </defs>
        <rect x='0' y='0' width='1280' height='719' fill='#F0EBDE' />
        <rect x='0' y='0' width='1280' height='719' fill='url(#grid)' />
        <rect x='990' y='58' width='108' height='86' fill='url(#scan)' />
        <rect x='950' y='144' width='142' height='74' fill='url(#scan)' />
        <rect x='984' y='218' width='130' height='68' fill='url(#scan)' />
        <rect x='932' y='286' width='170' height='80' fill='url(#scan)' />
        <rect x='966' y='366' width='136' height='68' fill='url(#scan)' />
        <rect x='940' y='434' width='176' height='86' fill='url(#scan)' />
        <rect x='984' y='520' width='124' height='74' fill='url(#scan)' />
        <rect x='950' y='594' width='142' height='70' fill='url(#scan)' />
    </svg>

    <Box style={{ position: 'relative', zIndex: 1, width: 1184, height: 687 }}>
        <Box style={{ width: 1184, height: 1.5, background: '#1F2BE0' }} />

        <Text style={{ marginTop: 118, fontFamily: 'STSong', fontSize: 104, fontWeight: 700, color: '#1F2BE0', lineHeight: 1.04, whiteSpace: 'nowrap' }}>
            新能源汽车<br />后市场 <span style={{ fontFamily: 'Times New Roman', fontWeight: 400, letterSpacing: -1 }}>2026</span>
        </Text>

        <Text style={{ marginTop: 74, fontFamily: 'Microsoft YaHei', fontSize: 13, fontWeight: 700, color: '#1F2BE0', whiteSpace: 'nowrap' }}>
            战略研究 · 中国市场 · <span style={{ fontFamily: 'Courier New', letterSpacing: 2.2 }}>VOLUME 2026</span>
        </Text>
        <Text style={{ marginTop: 10, fontFamily: 'STSong', fontSize: 30, fontWeight: 400, color: '#1F2BE0', lineHeight: 1.2, whiteSpace: 'nowrap' }}>
            存量车龄拐点之后，谁来承接 1.3 万亿元的服务需求
        </Text>

        <Box style={{ flexDirection: 'row', gap: 72, marginTop: 92, height: 50 }}>
            <Box style={{ width: 300 }}>
                <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 13, fontWeight: 700, color: '#1F2BE0', whiteSpace: 'nowrap' }}>研究团队</Text>
                <Text style={{ marginTop: 8, fontFamily: 'Microsoft YaHei', fontSize: 16, color: '#1F2BE0', whiteSpace: 'nowrap' }}>战略研究部 · 汽车与出行组</Text>
            </Box>
            <Box style={{ width: 380 }}>
                <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 13, fontWeight: 700, color: '#1F2BE0', whiteSpace: 'nowrap' }}>发布</Text>
                <Text style={{ marginTop: 8, fontFamily: 'Microsoft YaHei', fontSize: 16, color: '#1F2BE0', whiteSpace: 'nowrap' }}>2026 年 9 月 · 内部讨论稿 <span style={{ fontFamily: 'Courier New' }}>v1.0</span></Text>
            </Box>
        </Box>

        <Text style={{ position: 'absolute', right: 0, bottom: 30, fontFamily: 'Courier New', fontSize: 13, color: '#1F2BE0', letterSpacing: 1 }}>01 / 12</Text>
        <Box style={{ position: 'absolute', left: 0, bottom: 0, width: 1184, height: 1.5, background: '#1F2BE0' }} />

        <Box style={{ position: 'absolute', top: 40, right: 0, width: 58, height: 58, background: '#F0EBDE', padding: 4, gap: 1.5 }}>
            {['10110101', '01101010', '10010111', '11101101', '01010010', '10111101', '11001011', '10110110'].map((row, r) => (
                <Box key={r} style={{ flexDirection: 'row', gap: 1.5 }}>
                    {row.split('').map((c, i) => (
                        <Box key={i} style={{ width: 4.8, height: 4.8, background: c === '1' ? '#1F2BE0' : '#F0EBDE' }} />
                    ))}
                </Box>
            ))}
        </Box>
    </Box>
</Slide>
